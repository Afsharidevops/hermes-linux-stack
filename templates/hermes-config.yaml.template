_config_version: 33
model:
  provider: custom:9router
  default: auto
custom_providers:
  - name: 9router via Hermes Smart Router
    base_url: http://smart-router:8080/v1
    key_env: NINEROUTER_API_KEY
agent:
  max_turns: 90
approvals:
  mode: manual
  timeout: 300
  cron_mode: deny
tool_loop_guardrails:
  hard_stop_enabled: true
  hard_stop_after:
    exact_failure: 5
    idempotent_no_progress: 5
gateway:
  platforms:
    telegram:
      extra:
        disable_link_previews: true
