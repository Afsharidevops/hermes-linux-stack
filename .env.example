# Generated by ./install.sh. Do not commit the real .env file.
COMPOSE_PROFILES=9router,smart-router,hermes,open-webui

NINEROUTER_IMAGE=decolua/9router:latest
NINEROUTER_BIND_IP=127.0.0.1
NINEROUTER_PORT=20128
NINEROUTER_INITIAL_PASSWORD=CHANGE_ME
NINEROUTER_JWT_SECRET=CHANGE_ME
NINEROUTER_API_KEY_SECRET=CHANGE_ME
NINEROUTER_MACHINE_ID_SALT=CHANGE_ME
NINEROUTER_REQUIRE_API_KEY=false
NINEROUTER_AUTH_COOKIE_SECURE=false
NINEROUTER_PUBLIC_BASE_URL=http://localhost:20128

HERMES_IMAGE=nousresearch/hermes-agent:latest
HERMES_BIND_IP=127.0.0.1
HERMES_API_PORT=8642
HERMES_DASHBOARD_PORT=9119
HERMES_DASHBOARD=0
HERMES_UID=10000
HERMES_GID=10000
# Package installs remain unprivileged and persist under data/hermes/.
# Their container targets and trusted PATH ordering are enforced by Compose.

# Execution stays off until manage.sh enables one or more features.
EXECUTION_FEATURES=
EXECUTION_POLICY_GENERATION=0
EXECUTION_WORKSPACE_GENERATION=0
EXECUTION_BROKER_IMAGE=afsharidevops/hermes-execution-broker:0.1.1@sha256:dc88519c8f87d0720e0666e081dc74cd867ea8d5b019d59af50ac44a72bb55ed
EXECUTION_SANDBOX_IMAGE=python:3.13.5-slim-bookworm@sha256:4c2cf9917bd1cbacc5e9b07320025bdb7cdf2df7b0ceaccb55e9dd7e30987419
EXECUTION_RUN_AS=10003:10003
EXECUTION_DOCKER_GID=999
EXECUTION_WORKSPACE_HOST_PATH=/absolute/path/to/hermes-linux-stack/data/execution-workspace

SMART_ROUTER_IMAGE=afsharidevops/hermes-smart-router:0.4.0
SMART_ROUTER_MODE=observe
SMART_ROUTER_POLICY=heuristic
# Switch to calibrated only after evaluating your workload.
SMART_ROUTER_HMAC_SECRET=CHANGE_ME
SMART_ROUTER_POLICY_VERSION=4

SMART_ROUTER_OBSERVE_MODEL=ai

SMART_ROUTER_FAST_MODEL=combo-fast
SMART_ROUTER_STANDARD_MODEL=combo-standard
SMART_ROUTER_STRONG_MODEL=combo-strong

SMART_ROUTER_FAST_SUPPORTS_TOOLS=false
SMART_ROUTER_FAST_SUPPORTS_VISION=false
SMART_ROUTER_FAST_MAX_CONTEXT=32000

SMART_ROUTER_STANDARD_SUPPORTS_TOOLS=true
SMART_ROUTER_STANDARD_SUPPORTS_VISION=false
SMART_ROUTER_STANDARD_MAX_CONTEXT=128000

SMART_ROUTER_STRONG_SUPPORTS_TOOLS=true
SMART_ROUTER_STRONG_SUPPORTS_VISION=true
SMART_ROUTER_STRONG_MAX_CONTEXT=200000

SMART_ROUTER_SESSION_TTL_SECONDS=2700
SMART_ROUTER_MAX_SESSION_AGE_SECONDS=43200
SMART_ROUTER_DEMOTION_TURNS=5

SMART_ROUTER_FAST_MAX_TOKENS=1024
SMART_ROUTER_STANDARD_MAX_TOKENS=4096
SMART_ROUTER_STRONG_MAX_TOKENS=6144

SMART_ROUTER_CONNECT_TIMEOUT_SECONDS=10
SMART_ROUTER_READ_TIMEOUT_SECONDS=600
SMART_ROUTER_MAX_REQUEST_BYTES=10485760


OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
OPENWEBUI_BIND_IP=127.0.0.1
OPENWEBUI_PORT=3000
OPENWEBUI_URL=http://localhost:3000
OPENWEBUI_SECRET_KEY=CHANGE_ME
OPENWEBUI_OPENAI_BASE_URL=http://smart-router:8080/v1
# Automatically generated/reused in 9router when both services are selected.
OPENWEBUI_OPENAI_API_KEY=CHANGE_ME
OPENWEBUI_ENABLE_SIGNUP=true

N8N_IMAGE=n8nio/n8n:latest
# off, instance, or trigger. Instance access/token is enabled in the n8n owner UI.
N8N_MCP_MODE=off
N8N_BIND_IP=127.0.0.1
N8N_PORT=5678
N8N_HOSTNAME=localhost
N8N_PROTOCOL=http
N8N_PUBLIC_URL=http://localhost:5678
N8N_SECURE_COOKIE=false
N8N_PROXY_HOPS=0
N8N_TIMEZONE=UTC
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
# Rotating this makes every stored n8n credential undecryptable. Back it up.
N8N_ENCRYPTION_KEY=CHANGE_ME

CADDY_IMAGE=caddy:2-alpine
CADDY_BIND_IP=0.0.0.0
SMART_ROUTER_CALIBRATION_FILE=/policy/calibrated.json
SMART_ROUTER_UPSTREAM_BASE_URL=http://nine-router:20128/v1
SMART_ROUTER_UPSTREAM_HEALTH_URL=http://nine-router:20128/api/health
SMART_ROUTER_UPSTREAM_API_KEY=
SMART_ROUTER_CLIENT_API_KEY=
SMART_ROUTER_DATABASE_PATH=/data/router.sqlite3
SMART_ROUTER_OBSERVATION_FILE=/data/observations-v4.jsonl
SMART_ROUTER_PREFERRED_TOKEN_FIELD=max_tokens
SMART_ROUTER_LEARNED_MODEL_FILE=/policy/learned-v4.joblib
SMART_ROUTER_LEARNED_METADATA_FILE=/policy/learned-v4.json
SMART_ROUTER_LEARNED_MIN_CONFIDENCE=0.70
SMART_ROUTER_LEARNED_FALLBACK=standard
SMART_ROUTER_LEARNED_ERROR_FALLBACK=heuristic

# Smart Router v0.4.0 notes
# SMART_ROUTER_HMAC_SECRET is required and must be >=32 strong characters.
# Generate once: openssl rand -hex 32
# Keep it stable across restarts and never commit the real .env.

# Smart Router v0.4.0 hardening
# Conservative margin applied to approximate prompt-token counts for hard context gates.
SMART_ROUTER_CONTEXT_TOKEN_SAFETY_FACTOR=1.15
# Keep false for normal external clients. Set true only for trusted callers that may force tiers.
SMART_ROUTER_ALLOW_TIER_OVERRIDES=false

# Smart Router v0.5.0 measured cost dashboard
SMART_ROUTER_COST_LEDGER_ENABLED=true
SMART_ROUTER_COST_DATABASE_PATH=/data/cost-ledger.sqlite3
# Copy smart-router/policy/pricing-v0.5.example.json to pricing-v0.5.json and fill real prices before claiming USD savings.
SMART_ROUTER_PRICING_FILE=/policy/pricing-v0.5.json
SMART_ROUTER_DASHBOARD_ENABLED=true
