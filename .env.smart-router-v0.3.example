# Smart Router v0.3 integration values for branch: hermes-omniroute-linux-stack
SMART_ROUTER_MODE=observe
SMART_ROUTER_POLICY=heuristic
SMART_ROUTER_POLICY_VERSION=3
SMART_ROUTER_UPSTREAM_BASE_URL=http://omniroute:20129/v1
SMART_ROUTER_FAST_MODEL=auto
SMART_ROUTER_STANDARD_MODEL=auto
SMART_ROUTER_STRONG_MODEL=auto
SMART_ROUTER_FAST_MAX_TOKENS=1024
SMART_ROUTER_STANDARD_MAX_TOKENS=4096
SMART_ROUTER_STRONG_MAX_TOKENS=6144
SMART_ROUTER_FAST_SUPPORTS_TOOLS=false
SMART_ROUTER_STANDARD_SUPPORTS_TOOLS=true
SMART_ROUTER_STRONG_SUPPORTS_TOOLS=true
SMART_ROUTER_FAST_SUPPORTS_VISION=false
SMART_ROUTER_STANDARD_SUPPORTS_VISION=false
SMART_ROUTER_STRONG_SUPPORTS_VISION=true
SMART_ROUTER_FAST_MAX_CONTEXT=32000
SMART_ROUTER_STANDARD_MAX_CONTEXT=128000
SMART_ROUTER_STRONG_MAX_CONTEXT=200000
SMART_ROUTER_LEARNED_MODEL_FILE=/policy/learned-v3.joblib
SMART_ROUTER_LEARNED_METADATA_FILE=/policy/learned-v3.json
SMART_ROUTER_LEARNED_MIN_CONFIDENCE=0.70
SMART_ROUTER_LEARNED_FALLBACK=standard
SMART_ROUTER_LEARNED_ERROR_FALLBACK=heuristic
SMART_ROUTER_OBSERVATION_FILE=/data/observations-v3.jsonl
# Generate a strong value; do not commit real secrets.
SMART_ROUTER_CLIENT_API_KEY=
# Optional. Set only when OmniRoute requires an upstream bearer key.
SMART_ROUTER_UPSTREAM_API_KEY=
